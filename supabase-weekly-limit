create or replace function public.get_app_profile(p_user_id uuid)
returns table(user_id uuid,email text,display_name text,role text,active boolean)
language sql
security definer
set search_path=public
as $$
  select a.user_id,a.email,a.display_name,a.role,a.active
  from public.app_users a
  where a.user_id=p_user_id and a.active=true;
$$;

create or replace function public.get_weekly_id_usage()
returns table(
  used_count integer,
  remaining_count integer,
  week_start date,
  week_end date,
  reset_at timestamptz
)
language plpgsql
security definer
set search_path=public
as $$
declare
  v_week_start date:=public.current_nairobi_week_start();
  v_used integer;
begin
  select count(*)::integer into v_used
  from public.id_generations g
  where g.week_start=v_week_start;

  return query select v_used,greatest(0,15-v_used),v_week_start,v_week_start+6,
    ((v_week_start+7)::timestamp at time zone 'Africa/Nairobi');
end;
$$;

create or replace function public.register_id_generation(
  p_actor_user_id uuid,
  p_rider_number text,
  p_rider_name text,
  p_workplace_code text,
  p_generation_type text default 'INITIAL',
  p_confirm_duplicate boolean default false
)
returns table(
  allowed boolean,
  duplicate_detected boolean,
  permission_denied boolean,
  rider_id uuid,
  generation_id uuid,
  full_id_number text,
  rider_name text,
  workplace_name text,
  generated_at timestamptz,
  expires_at timestamptz,
  generation_number integer,
  used_count integer,
  remaining_count integer,
  weekly_sequence_number integer,
  reset_at timestamptz,
  current_status text,
  existing_expires_at timestamptz
)
language plpgsql
security definer
set search_path=public
as $$
declare
  v_week_start date:=public.current_nairobi_week_start();
  v_used integer;
  v_rider_id uuid;
  v_generation_id uuid;
  v_existing_generation_id uuid;
  v_existing_expires timestamptz;
  v_existing_status text;
  v_full_id text;
  v_workplace_name text;
  v_generated_at timestamptz:=now();
  v_expires_at timestamptz:=now()+interval '1 year';
  v_type text:=upper(trim(coalesce(p_generation_type,'INITIAL')));
  v_gen_number integer;
  v_actor_email text;
  v_actor_role text;
  v_clean_number text;
begin
  select actor_email,actor_role into v_actor_email,v_actor_role
  from public.require_app_role(
    p_actor_user_id,
    case when v_type='INITIAL' then array['ADMIN','OPERATOR']::text[] else array['ADMIN']::text[] end
  );

  if nullif(trim(p_rider_number),'') is null or nullif(trim(p_rider_name),'') is null then
    raise exception 'Rider number and rider name are required';
  end if;
  if p_workplace_code not in ('MG','EG') then raise exception 'Invalid workplace code'; end if;
  if v_type not in ('INITIAL','REGENERATION','RENEWAL') then raise exception 'Invalid generation type'; end if;

  v_clean_number:=upper(regexp_replace(trim(p_rider_number),'[^A-Za-z0-9-]','','g'));
  v_full_id:='MTS-'||p_workplace_code||'-'||v_clean_number;
  v_workplace_name:=case when p_workplace_code='EG' then 'EasyGas' else 'M-Gas' end;

  select r.id,r.operational_status,g.id,g.expires_at
  into v_rider_id,v_existing_status,v_existing_generation_id,v_existing_expires
  from public.rider_ids r
  left join lateral (
    select gg.id,gg.expires_at from public.id_generations gg
    where gg.rider_id=r.id order by gg.generated_at desc,gg.id desc limit 1
  ) g on true
  where r.full_id_number=v_full_id;

  -- Initial generation of an existing ID never silently consumes a slot.
  if v_type='INITIAL' and v_rider_id is not null and not p_confirm_duplicate then
    return query select false,true,false,v_rider_id,v_existing_generation_id,v_full_id,
      (select r.rider_name from public.rider_ids r where r.id=v_rider_id),v_workplace_name,
      null::timestamptz,null::timestamptz,
      (select coalesce(max(g.generation_number),0) from public.id_generations g where g.rider_id=v_rider_id),
      (select count(*)::integer from public.id_generations g where g.week_start=v_week_start),
      greatest(0,15-(select count(*)::integer from public.id_generations g where g.week_start=v_week_start)),
      null::integer,((v_week_start+7)::timestamp at time zone 'Africa/Nairobi'),
      case
        when v_existing_status='PAUSED' then 'PAUSED'
        when v_existing_status='REVOKED' then 'REVOKED'
        when v_existing_expires<=now() then 'EXPIRED'
        when v_existing_expires<=now()+interval '30 days' then 'EXPIRING_SOON'
        else 'ACTIVE'
      end,
      v_existing_expires;
    return;
  end if;

  -- A confirmed duplicate becomes a regeneration and therefore requires ADMIN.
  if v_type='INITIAL' and v_rider_id is not null and p_confirm_duplicate then
    if v_actor_role<>'ADMIN' then
      raise exception 'Only an admin can regenerate an existing ID';
    end if;
    v_type:='REGENERATION';
  end if;

  -- Renewal only makes sense for an existing ID; regeneration also requires one.
  if v_type in ('REGENERATION','RENEWAL') and v_rider_id is null then
    raise exception 'Existing Rider ID record not found';
  end if;

  -- Serialize the whole claim + write transaction for this Nairobi week.
  perform pg_advisory_xact_lock(hashtext('rider-id-week-'||v_week_start::text));

  select count(*)::integer into v_used from public.id_generations g where g.week_start=v_week_start;
  if v_used>=15 then
    return query select false,false,false,v_rider_id,null::uuid,v_full_id,p_rider_name,v_workplace_name,
      null::timestamptz,null::timestamptz,null::integer,v_used,0,null::integer,
      ((v_week_start+7)::timestamp at time zone 'Africa/Nairobi'),coalesce(v_existing_status,'ACTIVE'),v_existing_expires;
    return;
  end if;

  if v_rider_id is null then
    insert into public.rider_ids(rider_number,full_id_number,rider_name,workplace_code,workplace_name,
      operational_status,status_reason,status_changed_at)
    values(v_clean_number,v_full_id,trim(p_rider_name),p_workplace_code,v_workplace_name,'ACTIVE',null,now())
    returning id into v_rider_id;
  else
    update public.rider_ids
    set rider_number=v_clean_number,
        rider_name=trim(p_rider_name),
        workplace_code=p_workplace_code,
        workplace_name=v_workplace_name,
        operational_status='ACTIVE',
        status_reason=null,
        status_changed_at=now(),
        updated_at=now()
    where id=v_rider_id;
  end if;

  select coalesce(max(g.generation_number),0)+1 into v_gen_number
  from public.id_generations g where g.rider_id=v_rider_id;

  insert into public.id_generations(
    rider_id,generation_type,generation_number,rider_name_snapshot,rider_number_snapshot,
    full_id_number_snapshot,workplace_code_snapshot,workplace_name_snapshot,generated_at,expires_at,
    week_start,weekly_sequence_number,created_by
  ) values(
    v_rider_id,v_type,v_gen_number,trim(p_rider_name),v_clean_number,v_full_id,p_workplace_code,
    v_workplace_name,v_generated_at,v_expires_at,v_week_start,v_used+1,p_actor_user_id
  ) returning id into v_generation_id;

  insert into public.id_audit_log(rider_id,generation_id,actor_user_id,actor_email,actor_role,action,details)
  values(v_rider_id,v_generation_id,p_actor_user_id,v_actor_email,v_actor_role,v_type,
    jsonb_build_object('weekly_slot',v_used+1,'generation_number',v_gen_number,'full_id_number',v_full_id,'weekly_slot_used',true));

  return query select true,false,false,v_rider_id,v_generation_id,v_full_id,trim(p_rider_name),v_workplace_name,
    v_generated_at,v_expires_at,v_gen_number,v_used+1,15-(v_used+1),v_used+1,
    ((v_week_start+7)::timestamp at time zone 'Africa/Nairobi'),'ACTIVE'::text,v_existing_expires;
end;
$$;

create or replace function public.set_rider_id_status(
  p_actor_user_id uuid,
  p_rider_id uuid,
  p_action text,
  p_reason text default null
)
returns table(rider_id uuid,operational_status text,status_reason text,status_changed_at timestamptz)
language plpgsql
security definer
set search_path=public
as $$
declare
  v_action text:=upper(trim(coalesce(p_action,'')));
  v_current text;
  v_new text;
  v_reason text:=nullif(trim(coalesce(p_reason,'')),'');
  v_generation_id uuid;
  v_actor_email text;
  v_actor_role text;
begin
  select actor_email,actor_role into v_actor_email,v_actor_role
  from public.require_app_role(p_actor_user_id,array['ADMIN']::text[]);

  select r.operational_status into v_current
  from public.rider_ids r where r.id=p_rider_id for update;
  if not found then raise exception 'Rider ID record not found'; end if;

  if v_action='PAUSE' then
    if v_current<>'ACTIVE' then raise exception 'Only an active ID can be paused'; end if;
    if v_reason is null then raise exception 'A pause reason is required'; end if;
    v_new:='PAUSED';
  elsif v_action='RESUME' then
    if v_current<>'PAUSED' then raise exception 'Only a paused ID can be resumed'; end if;
    v_new:='ACTIVE'; v_reason:=null;
  elsif v_action='REVOKE' then
    if v_current='REVOKED' then raise exception 'ID is already revoked'; end if;
    if v_reason is null then raise exception 'A revocation reason is required'; end if;
    v_new:='REVOKED';
  else
    raise exception 'Invalid status action';
  end if;

  update public.rider_ids
  set operational_status=v_new,status_reason=v_reason,status_changed_at=now(),updated_at=now()
  where id=p_rider_id;

  select g.id into v_generation_id from public.id_generations g
  where g.rider_id=p_rider_id order by g.generated_at desc,g.id desc limit 1;

  insert into public.id_audit_log(rider_id,generation_id,actor_user_id,actor_email,actor_role,action,details)
  values(p_rider_id,v_generation_id,p_actor_user_id,v_actor_email,v_actor_role,
    case v_action when 'PAUSE' then 'PAUSED' when 'RESUME' then 'RESUMED' else 'REVOKED' end,
    jsonb_build_object('reason',v_reason,'previous_status',v_current,'new_status',v_new,'weekly_slot_used',false));

  return query select r.id,r.operational_status,r.status_reason,r.status_changed_at
  from public.rider_ids r where r.id=p_rider_id;
end;
$$;

create or replace function public.search_generated_ids(
  p_actor_user_id uuid,
  p_query text default '',
  p_workplace text default 'ALL',
  p_status text default 'ALL',
  p_period text default 'ALL'
)
returns table(
  rider_id uuid,
  full_id_number text,
  rider_number text,
  rider_name text,
  workplace_code text,
  workplace_name text,
  generation_id uuid,
  generation_type text,
  generation_number integer,
  generated_at timestamptz,
  expires_at timestamptz,
  status text,
  status_reason text,
  status_changed_at timestamptz,
  generation_count bigint
)
language plpgsql
security definer
set search_path=public
as $$
begin
  perform 1 from public.require_app_role(p_actor_user_id,array['ADMIN','OPERATOR','VIEWER']::text[]);
  return query
  with latest as (
    select distinct on (g.rider_id)
      g.rider_id,g.id,g.generation_type,g.generation_number,g.generated_at,g.expires_at
    from public.id_generations g
    order by g.rider_id,g.generated_at desc,g.id desc
  ), counts as (
    select g.rider_id,count(*) generation_count from public.id_generations g group by g.rider_id
  ), records as (
    select r.id rider_id,r.full_id_number,r.rider_number,r.rider_name,r.workplace_code,r.workplace_name,
      l.id generation_id,l.generation_type,l.generation_number,l.generated_at,l.expires_at,
      case
        when r.operational_status='PAUSED' then 'PAUSED'
        when r.operational_status='REVOKED' then 'REVOKED'
        when l.expires_at<=now() then 'EXPIRED'
        when l.expires_at<=now()+interval '30 days' then 'EXPIRING_SOON'
        else 'ACTIVE'
      end status,
      r.status_reason,r.status_changed_at,c.generation_count
    from public.rider_ids r join latest l on l.rider_id=r.id join counts c on c.rider_id=r.id
  )
  select x.rider_id,x.full_id_number,x.rider_number,x.rider_name,x.workplace_code,x.workplace_name,
    x.generation_id,x.generation_type,x.generation_number,x.generated_at,x.expires_at,x.status,
    x.status_reason,x.status_changed_at,x.generation_count
  from records x
  where (
      coalesce(trim(p_query),'')='' or x.full_id_number ilike '%'||trim(p_query)||'%'
      or x.rider_number ilike '%'||trim(p_query)||'%'
      or x.rider_name ilike '%'||trim(p_query)||'%'
      or x.workplace_name ilike '%'||trim(p_query)||'%'
    )
    and (upper(coalesce(p_workplace,'ALL'))='ALL' or x.workplace_code=upper(p_workplace))
    and (upper(coalesce(p_status,'ALL'))='ALL' or x.status=upper(p_status))
    and (
      upper(coalesce(p_period,'ALL'))='ALL'
      or (upper(p_period)='THIS_WEEK' and x.generated_at >= (public.current_nairobi_week_start()::timestamp at time zone 'Africa/Nairobi'))
      or (upper(p_period)='THIS_MONTH' and x.generated_at >= date_trunc('month',timezone('Africa/Nairobi',now())) at time zone 'Africa/Nairobi')
    )
  order by x.generated_at desc
  limit 500;
end;
$$;

create or replace function public.get_rider_generation_history(p_actor_user_id uuid,p_rider_id uuid)
returns table(
  generation_id uuid,generation_number integer,generation_type text,generated_at timestamptz,expires_at timestamptz,
  rider_name text,rider_number text,full_id_number text,workplace_code text,workplace_name text,
  generation_status text,weekly_sequence_number integer,created_by_email text
)
language plpgsql
security definer
set search_path=public
as $$
begin
  perform 1 from public.require_app_role(p_actor_user_id,array['ADMIN','OPERATOR','VIEWER']::text[]);
  return query
  select g.id,g.generation_number,g.generation_type,g.generated_at,g.expires_at,
    coalesce(g.rider_name_snapshot,r.rider_name),coalesce(g.rider_number_snapshot,r.rider_number),
    coalesce(g.full_id_number_snapshot,r.full_id_number),coalesce(g.workplace_code_snapshot,r.workplace_code),
    coalesce(g.workplace_name_snapshot,r.workplace_name),
    case
      when exists(select 1 from public.id_generations g2 where g2.rider_id=g.rider_id and g2.generation_number>g.generation_number and g2.generation_type='RENEWAL') then 'RENEWED'
      when g.expires_at<=now() then 'EXPIRED'
      when g.expires_at<=now()+interval '30 days' then 'EXPIRING_SOON'
      else 'ACTIVE'
    end,
    g.weekly_sequence_number,au.email
  from public.id_generations g
  join public.rider_ids r on r.id=g.rider_id
  left join public.app_users au on au.user_id=g.created_by
  where g.rider_id=p_rider_id
  order by g.generation_number desc;
end;
$$;

create or replace function public.log_id_action(
  p_actor_user_id uuid,
  p_rider_id uuid,
  p_generation_id uuid,
  p_action text,
  p_details jsonb default '{}'::jsonb
)
returns void
language plpgsql
security definer
set search_path=public
as $$
declare
  v_action text:=upper(trim(p_action));
  v_actor_email text;
  v_actor_role text;
begin
  select actor_email,actor_role into v_actor_email,v_actor_role
  from public.require_app_role(p_actor_user_id,array['ADMIN','OPERATOR','VIEWER']::text[]);
  if v_action not in ('DOWNLOAD_FRONT','DOWNLOAD_BACK','DOWNLOAD_PDF','VIEWED') then
    raise exception 'Invalid audit action';
  end if;
  insert into public.id_audit_log(rider_id,generation_id,actor_user_id,actor_email,actor_role,action,details)
  values(p_rider_id,p_generation_id,p_actor_user_id,v_actor_email,v_actor_role,v_action,coalesce(p_details,'{}'::jsonb));
end;
$$;

create or replace function public.get_id_audit_log(
  p_actor_user_id uuid,
  p_query text default '',
  p_action text default 'ALL',
  p_period text default 'ALL',
  p_limit integer default 500
)
returns table(
  audit_id bigint,created_at timestamptz,action text,full_id_number text,rider_name text,workplace_name text,
  generation_type text,generation_number integer,actor_email text,actor_role text,details jsonb
)
language plpgsql
security definer
set search_path=public
as $$
begin
  perform 1 from public.require_app_role(p_actor_user_id,array['ADMIN']::text[]);
  return query
  select a.id,a.created_at,a.action,r.full_id_number,r.rider_name,r.workplace_name,g.generation_type,g.generation_number,
    a.actor_email,a.actor_role,a.details
  from public.id_audit_log a
  left join public.rider_ids r on r.id=a.rider_id
  left join public.id_generations g on g.id=a.generation_id
  where (
      coalesce(trim(p_query),'')='' or coalesce(r.full_id_number,'') ilike '%'||trim(p_query)||'%'
      or coalesce(r.rider_name,'') ilike '%'||trim(p_query)||'%'
      or coalesce(a.actor_email,'') ilike '%'||trim(p_query)||'%'
    )
    and (upper(coalesce(p_action,'ALL'))='ALL' or a.action=upper(p_action))
    and (
      upper(coalesce(p_period,'ALL'))='ALL'
      or (upper(p_period)='THIS_WEEK' and a.created_at >= (public.current_nairobi_week_start()::timestamp at time zone 'Africa/Nairobi'))
      or (upper(p_period)='THIS_MONTH' and a.created_at >= date_trunc('month',timezone('Africa/Nairobi',now())) at time zone 'Africa/Nairobi')
    )
  order by a.created_at desc
  limit least(greatest(coalesce(p_limit,500),1),2000);
end;
$$;

create or replace function public.get_id_dashboard_summary(p_actor_user_id uuid)
returns table(
  total_riders bigint,active_ids bigint,paused_ids bigint,revoked_ids bigint,expired_ids bigint,expiring_soon bigint,
  used_this_week integer,remaining_this_week integer
)
language plpgsql
security definer
set search_path=public
as $$
begin
  perform 1 from public.require_app_role(p_actor_user_id,array['ADMIN','OPERATOR','VIEWER']::text[]);
  return query
  with latest as (
    select distinct on(g.rider_id) g.rider_id,g.expires_at
    from public.id_generations g order by g.rider_id,g.generated_at desc,g.id desc
  ), s as (
    select r.id,r.operational_status,l.expires_at,
      case
        when r.operational_status='PAUSED' then 'PAUSED'
        when r.operational_status='REVOKED' then 'REVOKED'
        when l.expires_at<=now() then 'EXPIRED'
        when l.expires_at<=now()+interval '30 days' then 'EXPIRING_SOON'
        else 'ACTIVE'
      end status
    from public.rider_ids r join latest l on l.rider_id=r.id
  ), w as (
    select count(*)::integer used from public.id_generations g where g.week_start=public.current_nairobi_week_start()
  )
  select count(*)::bigint,
    count(*) filter(where s.status='ACTIVE')::bigint,
    count(*) filter(where s.status='PAUSED')::bigint,
    count(*) filter(where s.status='REVOKED')::bigint,
    count(*) filter(where s.status='EXPIRED')::bigint,
    count(*) filter(where s.status='EXPIRING_SOON')::bigint,
    w.used,greatest(0,15-w.used)
  from s cross join w
  group by w.used;
end;
$$;

