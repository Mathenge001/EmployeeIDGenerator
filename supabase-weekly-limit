-- Rider ID Generator production upgrade
-- Features: Supabase Auth roles, Sunday-Saturday 15/week limit, atomic generation,
-- duplicate protection, generation numbering/history, pause/resume/revoke,
-- expiry/renewal, append-only audit log, filters and dashboard summaries.
-- Run this ENTIRE file in Supabase SQL Editor.

create extension if not exists pgcrypto;

-- -----------------------------------------------------------------------------
-- 1) USERS / ROLES
-- -----------------------------------------------------------------------------
create table if not exists public.app_users (
  user_id uuid primary key references auth.users(id) on delete cascade,
  email text,
  display_name text,
  role text not null default 'VIEWER' check (role in ('ADMIN','OPERATOR','VIEWER')),
  active boolean not null default true,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

alter table public.app_users enable row level security;
revoke all on public.app_users from anon, authenticated;

-- Existing Supabase Auth users are added as VIEWER by default.
insert into public.app_users (user_id, email, display_name, role, active)
select u.id, u.email, coalesce(u.raw_user_meta_data->>'full_name', u.email), 'VIEWER', true
from auth.users u
on conflict (user_id) do update
set email = excluded.email,
    display_name = coalesce(public.app_users.display_name, excluded.display_name),
    updated_at = now();

create or replace function public.handle_new_auth_user()
returns trigger
language plpgsql
security definer
set search_path = public
as $$
begin
  insert into public.app_users(user_id,email,display_name,role,active)
  values(new.id,new.email,coalesce(new.raw_user_meta_data->>'full_name',new.email),'VIEWER',true)
  on conflict (user_id) do update
    set email=excluded.email,
        display_name=coalesce(public.app_users.display_name,excluded.display_name),
        updated_at=now();
  return new;
end;
$$;

drop trigger if exists on_auth_user_created_id_generator on auth.users;
create trigger on_auth_user_created_id_generator
after insert on auth.users
for each row execute procedure public.handle_new_auth_user();

-- -----------------------------------------------------------------------------
-- 2) CORE TABLES
-- -----------------------------------------------------------------------------
create table if not exists public.rider_ids (
  id uuid primary key default gen_random_uuid(),
  rider_number text not null,
  full_id_number text not null unique,
  rider_name text not null,
  workplace_code text not null check (workplace_code in ('MG','EG')),
  workplace_name text not null,
  operational_status text not null default 'ACTIVE',
  status_reason text,
  status_changed_at timestamptz not null default now(),
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

alter table public.rider_ids add column if not exists operational_status text not null default 'ACTIVE';
alter table public.rider_ids add column if not exists status_reason text;
alter table public.rider_ids add column if not exists status_changed_at timestamptz not null default now();

do $$
begin
  if not exists (
    select 1 from pg_constraint
    where conname='rider_ids_operational_status_check'
      and conrelid='public.rider_ids'::regclass
  ) then
    alter table public.rider_ids
      add constraint rider_ids_operational_status_check
      check (operational_status in ('ACTIVE','PAUSED','REVOKED'));
  end if;
end $$;

create table if not exists public.id_generations (
  id uuid primary key default gen_random_uuid(),
  rider_id uuid not null references public.rider_ids(id) on delete cascade,
  generation_type text not null check (generation_type in ('INITIAL','REGENERATION','RENEWAL')),
  generation_number integer,
  rider_name_snapshot text,
  rider_number_snapshot text,
  full_id_number_snapshot text,
  workplace_code_snapshot text,
  workplace_name_snapshot text,
  generated_at timestamptz not null default now(),
  expires_at timestamptz not null,
  week_start date not null,
  weekly_sequence_number integer not null check (weekly_sequence_number between 1 and 15),
  created_by uuid
);

alter table public.id_generations add column if not exists generation_number integer;
alter table public.id_generations add column if not exists rider_name_snapshot text;
alter table public.id_generations add column if not exists rider_number_snapshot text;
alter table public.id_generations add column if not exists full_id_number_snapshot text;
alter table public.id_generations add column if not exists workplace_code_snapshot text;
alter table public.id_generations add column if not exists workplace_name_snapshot text;
alter table public.id_generations add column if not exists created_by uuid;

-- Backfill generation numbers and snapshots for data from earlier versions.
with numbered as (
  select id,
         row_number() over(partition by rider_id order by generated_at,id)::integer as rn
  from public.id_generations
)
update public.id_generations g
set generation_number=n.rn
from numbered n
where g.id=n.id and g.generation_number is null;

update public.id_generations g
set rider_name_snapshot=coalesce(g.rider_name_snapshot,r.rider_name),
    rider_number_snapshot=coalesce(g.rider_number_snapshot,r.rider_number),
    full_id_number_snapshot=coalesce(g.full_id_number_snapshot,r.full_id_number),
    workplace_code_snapshot=coalesce(g.workplace_code_snapshot,r.workplace_code),
    workplace_name_snapshot=coalesce(g.workplace_name_snapshot,r.workplace_name)
from public.rider_ids r
where r.id=g.rider_id;

create unique index if not exists uq_generation_number_per_rider
on public.id_generations(rider_id,generation_number)
where generation_number is not null;

create table if not exists public.id_audit_log (
  id bigint generated always as identity primary key,
  rider_id uuid references public.rider_ids(id) on delete set null,
  generation_id uuid references public.id_generations(id) on delete set null,
  actor_user_id uuid,
  actor_email text,
  actor_role text,
  action text not null,
  details jsonb not null default '{}'::jsonb,
  created_at timestamptz not null default now()
);

alter table public.id_audit_log add column if not exists actor_user_id uuid;
alter table public.id_audit_log add column if not exists actor_email text;
alter table public.id_audit_log add column if not exists actor_role text;

create index if not exists idx_id_generations_week_start on public.id_generations(week_start);
create index if not exists idx_id_generations_rider on public.id_generations(rider_id,generated_at desc);
create index if not exists idx_rider_ids_lookup on public.rider_ids(full_id_number,rider_number,rider_name);
create index if not exists idx_rider_ids_status on public.rider_ids(operational_status);
create index if not exists idx_audit_created on public.id_audit_log(created_at desc);
create index if not exists idx_audit_actor on public.id_audit_log(actor_user_id,created_at desc);

alter table public.rider_ids enable row level security;
alter table public.id_generations enable row level security;
alter table public.id_audit_log enable row level security;

revoke all on public.rider_ids from anon, authenticated;
revoke all on public.id_generations from anon, authenticated;
revoke all on public.id_audit_log from anon, authenticated;

