create or replace function public.current_nairobi_week_start()
returns date
language sql
stable
set search_path=public
as $$
  select ((timezone('Africa/Nairobi',now()))::date
          - extract(dow from timezone('Africa/Nairobi',now()))::integer)::date;
$$;

create or replace function public.require_app_role(p_user_id uuid,p_allowed text[])
returns table(actor_email text,actor_role text)
language plpgsql
security definer
set search_path=public
as $$
declare
  v_email text;
  v_role text;
  v_active boolean;
begin
  select email,role,active into v_email,v_role,v_active
  from public.app_users
  where user_id=p_user_id;

  if not found or not coalesce(v_active,false) then
    raise exception 'User is not authorized for this application';
  end if;
  if not (v_role=any(p_allowed)) then
    raise exception 'Your role is not permitted to perform this action';
  end if;

  return query select v_email,v_role;
end;
$$;

